---
// Every point here comes from the client's own published terms & conditions (/terms).
const facts = [
  {
    value: '12-month',
    label: 'Workmanship guarantee on all new work',
    icon: 'M12 3l7 3v5c0 4.6-3 8.4-7 10-4-1.6-7-5.4-7-10V6l7-3zM8.5 12l2.5 2.5 4.5-5',
  },
  {
    value: '£1m cover',
    label: 'Public and employers’ liability insurance',
    icon: 'M3 12a9 9 0 0 1 18 0H3zM12 12v6.5a2 2 0 0 1-4 0M12 3v0',
  },
  {
    value: 'Written quotes',
    label: 'Every quotation, and every extra cost, in writing',
    icon: 'M7 3h7l4 4v14H7V3zM14 3v4h4M10 12h5M10 15.5h5',
  },
  {
    value: 'Payment plan',
    label: 'Agreed with you before any work starts',
    icon: 'M4 6h16v14H4V6zM4 10h16M8 3v4M16 3v4M8.5 14.5l2 2 4-4',
  },
];
---
<section class="trust on-light" aria-label="Our commitments">
  <div class="container">
    <ul class="trust__list" role="list">
      {facts.map((f) => (
        <li class="trust__item" data-reveal>
          <span class="trust__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="24" height="24"><path d={f.icon} fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" /></svg>
          </span>
          <p class="trust__value">{f.value}</p>
          <p class="trust__label">{f.label}</p>
        </li>
      ))}
    </ul>
    <p class="trust__note">Full details in our <a href="/terms">terms &amp; conditions</a>.</p>
  </div>
</section>

<style>
  .trust { padding-block: clamp(56px, 7vw, 96px) clamp(16px, 2vw, 24px); }
  .trust__list { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; margin: 0; padding: 0; }
  .trust__item {
    display: grid; align-content: start; gap: 10px;
    padding: 28px 26px 30px;
    border: 1px solid var(--rule);
    background: #fff;
    transition: border-color 0.3s ease, box-shadow 0.3s ease, transform 0.4s var(--ease-out);
  }
  .trust__item:hover { border-color: var(--brand); box-shadow: 0 18px 40px -24px rgba(8, 118, 244, 0.45); transform: translateY(-3px); }
  .trust__icon {
    display: grid; place-items: center; width: 48px; height: 48px; margin-bottom: 14px;
    background: rgba(8, 118, 244, 0.08); color: var(--brand);
  }
  .trust__value { font: 700 22px/1.2 var(--font-display); letter-spacing: -0.02em; color: var(--char); }
  .trust__label { font-size: 15px; line-height: 1.55; color: var(--char-dim); }
  .trust__note { margin-top: 20px; font-size: 13px; color: var(--char-faint); }
  .trust__note a { color: var(--char-dim); }

  @media (max-width: 980px) {
    .trust__list { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 480px) {
    .trust__list { grid-template-columns: 1fr; gap: 12px; }
    .trust__item { grid-template-columns: 48px 1fr; column-gap: 16px; row-gap: 4px; padding: 20px; }
    .trust__icon { grid-row: span 2; margin-bottom: 0; }
  }
</style>
