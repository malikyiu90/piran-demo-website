---
import Faq from './Faq.astro';
import { faqs } from '../data/faqs';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
---
<section class="faqs section on-light" id="faq" aria-labelledby="faq-title">
  <div class="container faqs__grid">
    <div class="faqs__intro">
      <p class="eyebrow" data-reveal>FAQs</p>
      <h2 class="h2" id="faq-title" data-reveal>Common questions.</h2>
      <p class="lede" data-reveal>Can’t find what you need? Call <a href="tel:+447405308436">+44 7405 308436</a> and we’ll help.</p>
    </div>
    <Faq items={faqs} />
  </div>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
</section>

<style>
  .faqs__grid { display: grid; grid-template-columns: 0.8fr 1.2fr; gap: clamp(40px, 6vw, 96px); align-items: start; }
  .faqs__intro { display: grid; gap: 20px; position: sticky; top: 120px; }
  .faqs__intro a { color: var(--brand-tint); font-weight: 600; }
  @media (max-width: 900px) {
    .faqs__grid { grid-template-columns: 1fr; }
    .faqs__intro { position: static; }
  }
</style>
