---
import { featuredServices, serviceUrl } from '../data/services';
import { areas } from '../data/areas';
import { nav, proof, site } from '../data/site';

// Footer social icons; each appears once its link is set in site.ts (Google links to the reviews profile).
const ICONS = {
  facebook: '<path fill="currentColor" d="M9.101 23.691v-7.98H6.627v-3.667h2.474v-1.58c0-4.085 1.848-5.978 5.858-5.978.401 0 .955.042 1.468.103a8.68 8.68 0 0 1 1.141.195v3.325a8.623 8.623 0 0 0-.653-.036 26.805 26.805 0 0 0-.733-.009c-.707 0-1.259.096-1.675.309a1.686 1.686 0 0 0-.679.622c-.258.42-.374.995-.374 1.752v1.297h3.919l-.386 2.103-.287 1.564h-3.246v8.245C19.396 23.238 24 18.179 24 12.044c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.628 3.874 10.35 9.101 11.647Z"/>',
  instagram: '<rect x="3" y="3" width="18" height="18" rx="5" fill="none" stroke="currentColor" stroke-width="2"/><circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="2"/><circle cx="17.3" cy="6.7" r="1.2" fill="currentColor"/>',
  tiktok: '<path fill="currentColor" d="M12.53.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.15 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z"/>',
  google: '<path fill="currentColor" d="M21.8 10.2H12v3.9h5.6c-.5 2.6-2.8 4.1-5.6 4.1a6.2 6.2 0 1 1 4-10.9l2.9-2.9A10.3 10.3 0 0 0 12 1.7a10.3 10.3 0 1 0 0 20.6c5.9 0 10-4.2 10-10.1 0-.7-.1-1.4-.2-2z"/>',
};
const socials = [
  { label: 'Facebook', href: site.social.facebook, icon: ICONS.facebook },
  { label: 'Instagram', href: site.social.instagram, icon: ICONS.instagram },
  { label: 'TikTok', href: site.social.tiktok, icon: ICONS.tiktok },
  { label: 'Google', href: proof.googleReviewsUrl, icon: ICONS.google },
].filter((s): s is { label: string; href: string; icon: string } => Boolean(s.href));

interface Props {
  showCta?: boolean;
}
const { showCta = true } = Astro.props;
const year = new Date().getFullYear();
---
<footer class="footer">
  {showCta && (
    <section class="footer-cta container" aria-labelledby="footer-cta-title">
      <div>
        <h2 class="h2" id="footer-cta-title" data-reveal>Have a project in mind?</h2>
        <p class="lede" data-reveal>Tell us what you want to build. We’ll call you to talk it through, then follow up with a proposal and written quotation.</p>
      </div>
      <div class="footer-cta__actions" data-reveal>
        <a class="btn btn--primary" href="/contact#quote">
          Get a free quote
          <svg aria-hidden="true" viewBox="0 0 24 24" width="18" height="18"><path fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M13 6l6 6-6 6"/></svg>
        </a>
        <a class="btn btn--ghost" href={site.phoneHref}>{site.phone}</a>
      </div>
    </section>
  )}

  <section class="hiring on-brand" aria-labelledby="hiring-title">
    <div class="container hiring__inner">
      <div>
        <h2 class="hiring__title" id="hiring-title">We’re hiring</h2>
        <p>{site.name} is growing and looking for talented builders, designers and consultants to join the team.</p>
      </div>
      <a class="hiring__btn" href={`mailto:${site.email}?subject=Joining%20the%20team`}>Get in touch</a>
    </div>
  </section>

  <div class="footer-main container">
    <div class="footer-col footer-col--about">
      <a class="footer-brand" href="/" aria-label={`${site.name} home`}>
        <img src="/logo.png" alt={site.name} width="672" height="366" loading="lazy" />
      </a>
      <p class="footer-text">Construction and renovation in {site.locality}, from window work and plastering to kitchens, bathrooms and double-storey extensions.</p>
      {socials.length > 0 && (
        <div class="footer-socials">
          <p class="footer-socials__label">Follow us</p>
          <ul role="list" class="footer-socials__list">
            {socials.map((s) => (
              <li>
                <a class="footer-socials__link" href={s.href} target="_blank" rel="noopener" aria-label={`${site.name} on ${s.label}`} title={s.label}>
                  <svg aria-hidden="true" viewBox="0 0 24 24" width="20" height="20" set:html={s.icon} />
                </a>
              </li>
            ))}
          </ul>
        </div>
      )}
      <p class="footer-legal">{site.legalName}, registered in England &amp; Wales, company no. {site.companyNumber}. Registered office: {site.registeredOffice}.</p>
    </div>

    <nav class="footer-col" aria-label="Services">
      <h2 class="footer-heading">Services</h2>
      <ul role="list">
        {featuredServices().slice(0, 6).map((s) => <li><a href={serviceUrl(s)}>{s.name}</a></li>)}
        <li><a href="/services">All services</a></li>
      </ul>
    </nav>

    <nav class="footer-col" aria-label="Areas we cover">
      <h2 class="footer-heading">Areas we cover</h2>
      <ul role="list">
        {areas.map((a) => <li><a href={`/areas-we-cover#${a.id}`}>{a.name}</a></li>)}
        <li><a href="/areas-we-cover">All areas</a></li>
      </ul>
    </nav>

    <nav class="footer-col" aria-label="Company">
      <h2 class="footer-heading">Quick links</h2>
      <ul role="list">
        <li><a href="/">Home</a></li>
        {nav.filter((n) => n.href !== '/services').map((n) => <li><a href={n.href}>{n.label}</a></li>)}
        <li><a href="/terms">Terms &amp; conditions</a></li>
        <li><a href="/privacy">Privacy</a></li>
      </ul>
    </nav>

    <div class="footer-col">
      <h2 class="footer-heading">Contact</h2>
      <ul role="list" class="footer-contact">
        <li>Office: <a href={site.phoneHref}>{site.phone}</a></li>
        <li>Mobile: <a href={site.mobileHref}>{site.mobile}</a></li>
        <li><a href={site.whatsappHref} target="_blank" rel="noopener">WhatsApp {site.mobile}</a></li>
        <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
        <li>{site.location}</li>
      </ul>
    </div>
  </div>

  <div class="footer-bottom on-brand">
    <div class="container footer-bottom__inner">
      <p>© {year} {site.name}. All rights reserved.</p>
      <p>Powered by <a href="https://growyourbusiness.uk" target="_blank" rel="noopener">Grow Your Business</a></p>
      <a href="#main" data-to-top>Back to top ↑</a>
    </div>
  </div>
</footer>

<style>
  .footer { background: var(--ink); color: var(--paper); }

  .footer-cta {
    display: grid; grid-template-columns: 1fr auto; gap: 32px 64px; align-items: end;
    padding-top: clamp(80px, 10vw, 140px); padding-bottom: clamp(64px, 8vw, 110px);
  }
  .footer-cta .lede { margin-top: 18px; }
  .footer-cta__actions { display: flex; flex-wrap: wrap; gap: 12px; }

  .hiring { padding-block: 36px; }
  .hiring__inner { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 20px 48px; }
  .hiring__title { font: 700 clamp(26px, 2.6vw, 36px)/1.1 var(--font-display); letter-spacing: -0.03em; text-transform: uppercase; }
  .hiring p { margin-top: 8px; max-width: 64ch; color: rgba(0, 0, 0, 0.78); }
  .hiring__btn {
    display: inline-flex; align-items: center; height: 52px; padding: 0 28px;
    border: 2px solid var(--on-brand); color: var(--on-brand); text-decoration: none;
    font-weight: 700; letter-spacing: 0.04em; text-transform: uppercase; font-size: 14px;
    transition: background-color 0.25s ease, color 0.25s ease;
  }
  .hiring__btn:hover { background: var(--on-brand); color: var(--brand-tint); }

  .footer-main {
    display: grid; grid-template-columns: 1.4fr 1fr 0.9fr 0.9fr 1.2fr; gap: 40px;
    padding-top: clamp(56px, 7vw, 88px); padding-bottom: clamp(48px, 6vw, 72px);
  }
  .footer-brand { display: inline-block; }
  .footer-brand img { width: auto; height: clamp(96px, 8.5vw, 120px); }
  .footer-socials { margin-top: 22px; }
  .footer-socials__label { font-size: 12px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--brand-tint); margin-bottom: 10px; }
  .footer-col .footer-socials__list { display: flex; flex-wrap: wrap; gap: 10px; margin: 0; padding: 0; }
  .footer-col .footer-socials__link {
    display: grid; place-items: center; width: 44px; height: 44px; padding: 0; margin: 0; border-radius: 50%;
    border: 1px solid var(--line); color: var(--paper); transition: background-color 0.2s ease, color 0.2s ease, border-color 0.2s ease;
  }
  .footer-col .footer-socials__link:hover { background: var(--gold-fill); border-color: transparent; color: var(--on-brand); }
  .footer-text { margin-top: 18px; max-width: 38ch; color: var(--paper-faint); font-size: 15px; }
  /* Registered company details, which UK trading-disclosure rules require on the website. */
  .footer-legal { margin-top: 20px; max-width: 42ch; color: var(--paper-faint); font-size: 12.5px; line-height: 1.55; }

  .footer-heading { font-size: 16px; font-weight: 700; color: #fff; padding-bottom: 14px; margin-bottom: 18px; position: relative; }
  .footer-heading::after { content: ""; position: absolute; left: 0; bottom: 0; width: 48px; height: 3px; background: var(--gold-fill); }
  .footer-col ul { display: grid; gap: 10px; margin: 0; padding: 0; }
  .footer-col li { font-size: 15px; color: var(--paper-dim); }
  .footer-col a { display: inline-block; padding: 6px 0; margin: -6px 0; text-decoration: none; color: var(--paper-dim); transition: color 0.2s ease; }
  @media (pointer: coarse) {
    .footer-col ul { gap: 4px; }
    .footer-col a { padding: 12px 0; margin: -6px 0; }
  }
  .footer-col a:hover { color: #fff; }
  .footer-contact li { overflow-wrap: anywhere; }

  .footer-bottom__inner { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 8px 24px; padding-block: 20px; font-size: 14px; }
  @media (max-width: 640px) {
    .footer-bottom__inner { flex-direction: column; align-items: flex-start; padding-right: 88px; }
  }
  .footer-bottom a { color: var(--on-brand); font-weight: 600; text-decoration: none; }
  .footer-bottom a:hover { text-decoration: underline; }

  @media (max-width: 980px) {
    .footer-cta { grid-template-columns: 1fr; }
    .footer-main { grid-template-columns: 1fr 1fr; }
    .footer-col--about { grid-column: 1 / -1; }
  }
  @media (max-width: 520px) {
    .footer-main { grid-template-columns: 1fr; gap: 36px; }
    .footer-cta__actions .btn { flex: 1 1 auto; }
  }
</style>
