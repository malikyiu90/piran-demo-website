---
interface Crumb {
  label: string;
  href?: string;
}
interface Props {
  eyebrow: string;
  /** Title HTML; wrap the accent word in <em>. Content is authored in this repo, never user input. */
  title: string;
  lede?: string;
  image?: string;
  crumbs?: Crumb[];
}
const { eyebrow, title, lede, image = '/frames/lg/0095.webp', crumbs = [] } = Astro.props;
---
<section class="page-hero">
  <div class="page-hero__media" aria-hidden="true">
    <img src={image} alt="" width="1600" height="900" fetchpriority="high" decoding="async" data-parallax="10" />
  </div>
  <div class="page-hero__inner container">
    {crumbs.length > 0 && (
      <nav class="crumbs" aria-label="Breadcrumb">
        <ol role="list">
          <li><a href="/">Home</a></li>
          {crumbs.map((c) => <li>{c.href ? <a href={c.href}>{c.label}</a> : <span aria-current="page">{c.label}</span>}</li>)}
        </ol>
      </nav>
    )}
    <p class="eyebrow page-hero__eyebrow">{eyebrow}</p>
    <h1 class="h1 page-hero__title" set:html={title} />
    {lede && <p class="lede page-hero__lede">{lede}</p>}
    <slot />
  </div>
</section>

<script>
  import { gsap } from 'gsap';
  if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    gsap.from('.page-hero__inner > *', { autoAlpha: 0, y: 30, duration: 1.2, ease: 'expo.out', stagger: 0.08, delay: 0.1 });
  }
</script>

<style>
  .page-hero {
    position: relative; isolation: isolate; overflow: hidden;
    min-height: min(86svh, 820px); display: flex; align-items: flex-end;
    padding: calc(var(--header-h) + 72px) 0 clamp(56px, 8vw, 104px);
    background: var(--ink); color: var(--paper);
  }
  .page-hero__media { position: absolute; inset: -10% 0; z-index: -2; }
  .page-hero__media img { width: 100%; height: 100%; object-fit: cover; }
  .page-hero::before {
    content: ""; position: absolute; inset: 0; z-index: -1;
    background:
      linear-gradient(180deg, rgba(0, 0, 0, 0.7) 0%, rgba(0, 0, 0, 0.2) 35%, rgba(0, 0, 0, 0.85) 100%),
      linear-gradient(90deg, rgba(0, 0, 0, 0.75) 0%, rgba(0, 0, 0, 0) 70%);
  }
  .page-hero__inner { display: grid; gap: 24px; justify-items: start; }
  .page-hero__title { max-width: 15ch; }
  .page-hero__lede { max-width: 46ch; }

  .crumbs ol { display: flex; flex-wrap: wrap; gap: 8px; margin: 0; padding: 0; font-size: 13px; color: var(--paper-faint); }
  .crumbs li + li::before { content: "/"; margin-right: 8px; color: var(--line); }
  .crumbs a { color: var(--paper-dim); text-decoration: none; }
  .crumbs a:hover { color: var(--paper); }
  .crumbs [aria-current] { color: var(--paper); }
</style>
