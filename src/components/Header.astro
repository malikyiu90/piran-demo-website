---
import { nav, site } from '../data/site';
import { categories, servicesIn } from '../data/services';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCurrent = (href: string) => path === href || path.startsWith(`${href}/`);
---
<header class="site-header" data-header>
  <a class="brand" href="/" aria-label={`${site.name} home`}>
    <img class="brand__logo" src="/logo.png" alt={site.name} width="461" height="248" fetchpriority="high" />
  </a>

  <nav class="nav" aria-label="Primary">
    <ul class="nav__list" id="nav-menu" role="list" data-menu>
      {nav.map((item) => item.href === '/services' ? (
        <li class="has-mega">
          <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined} aria-haspopup="true">
            {item.label}
            <svg class="chev" aria-hidden="true" viewBox="0 0 24 24" width="14" height="14"><path fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" d="M6 9l6 6 6-6"/></svg>
          </a>
          <!-- Desktop dropdown: opens on hover and on keyboard focus. Hidden in the mobile menu. -->
          <div class="mega">
            <div class="mega__panel">
              {categories.map((c) => (
                <div class="mega__col">
                  <p class="mega__heading">{c.name}</p>
                  <ul role="list">
                    {servicesIn(c.id).map((s) => <li><a href={`/services/${s.slug}`}>{s.name}</a></li>)}
                  </ul>
                </div>
              ))}
              <a class="mega__all" href="/services">View all services <span aria-hidden="true">→</span></a>
            </div>
          </div>
        </li>
      ) : (
        <li><a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a></li>
      ))}
      <li class="nav__mobile-only"><a href={site.phoneHref}>Call {site.phone}</a></li>
      <li class="nav__mobile-only"><a href="/contact#quote" class="nav__mobile-cta">Get a free quote</a></li>
    </ul>
  </nav>

  <div class="header-actions">
    <a class="header-phone" href={site.phoneHref}>
      <svg aria-hidden="true" viewBox="0 0 24 24" width="16" height="16"><path fill="currentColor" d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25 11.4 11.4 0 0 0 3.6.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.57a1 1 0 0 1-.25 1z"/></svg>
      <span>{site.phone}</span>
    </a>
    <a class="btn btn--primary btn--sm header-cta" href="/contact#quote">Free consultation</a>
    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="nav-menu" data-menu-toggle>
      <span class="sr-only" data-menu-label>Open menu</span>
      <span class="menu-toggle__bar" aria-hidden="true"></span>
      <span class="menu-toggle__bar" aria-hidden="true"></span>
    </button>
  </div>
</header>

<style>
  .site-header {
    --header-h: 96px;
    position: fixed; inset: 0 0 auto 0; z-index: 50;
    height: var(--header-h);
    display: flex; align-items: center; justify-content: space-between; gap: 24px;
    padding: 0 var(--gutter);
    color: var(--paper);
    /* Solid black at rest and after the hero; see-through only while scrolling over the pinned hero (below). */
    background: #000;
    border-bottom: 1px solid var(--line-soft);
    transition: background-color 0.4s ease, height 0.4s var(--ease-out), border-color 0.4s ease, transform 0.5s var(--ease-out);
  }
  :global(.site-header.is-scrolled) {
    --header-h: 80px;
    background: #000;
    box-shadow: 0 1px 0 rgba(255, 255, 255, 0.08);
    border-bottom-color: var(--line-soft);
  }
  /* Over the pinned home hero the header stays see-through; the hero's own top shade keeps it legible. */
  :global(.over-hero .site-header.is-scrolled) {
    background: transparent;
    box-shadow: none;
    border-bottom-color: transparent;
  }

  /* The logo is drawn for dark backgrounds (white "LIMITED" and rules), which every header state uses. */
  .brand { flex: none; display: flex; align-items: center; text-decoration: none; }
  .brand__logo {
    --logo-h: 76px;
    width: auto; height: var(--logo-h);
    transition: height 0.4s var(--ease-out);
    filter: drop-shadow(0 2px 12px rgba(0, 0, 0, 0.35));
  }
  :global(.site-header.is-scrolled) .brand__logo { --logo-h: 60px; }

  .nav { align-self: stretch; display: flex; }
  .nav__list { display: flex; align-items: center; gap: 34px; height: 100%; margin: 0; padding: 0; }
  .nav__list a { position: relative; font-size: 14.5px; font-weight: 500; text-decoration: none; color: var(--paper-dim); transition: color 0.2s ease; }
  .nav__list a::after {
    content: ""; position: absolute; left: 0; right: 0; bottom: -6px; height: 1px;
    background: currentColor; transform: scaleX(0); transform-origin: right; transition: transform 0.35s var(--ease-out);
  }
  .nav__list a:hover, .nav__list a[aria-current="page"] { color: var(--paper); }
  .nav__list a:hover::after, .nav__list a[aria-current="page"]::after { transform: scaleX(1); transform-origin: left; }
  .nav__mobile-only { display: none; }

  /* ---------- Services dropdown (desktop) ----------
     The list item spans the full header height and the panel is positioned against the fixed header,
     so the pointer can travel from the link into the panel without the hover dropping, and the panel
     stays centred on the page whatever the link's position. */
  .has-mega { height: 100%; display: flex; align-items: center; }
  .has-mega > a { display: inline-flex; align-items: center; gap: 6px; }
  .chev { transition: transform 0.3s var(--ease-out); }
  .has-mega:hover .chev, .has-mega:focus-within .chev { transform: rotate(180deg); }
  .mega {
    position: absolute; top: 100%; left: 0; right: 0;
    display: flex; justify-content: center; padding: 0 var(--gutter);
    opacity: 0; visibility: hidden; transform: translateY(8px);
    transition: opacity 0.22s ease, visibility 0.22s, transform 0.3s var(--ease-out);
  }
  .has-mega:hover .mega, .has-mega:focus-within .mega { opacity: 1; visibility: visible; transform: none; }
  .mega__panel {
    width: min(920px, 100%); display: grid; grid-template-columns: repeat(4, 1fr); gap: 4px 28px;
    padding: 26px 28px 20px; background: #fff; color: #000;
    border-top: 3px solid var(--brand); border-radius: 0 0 12px 12px;
    box-shadow: 0 30px 80px -20px rgba(0, 0, 0, 0.55);
  }
  .mega__heading {
    font-size: 12px; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: var(--char-faint);
    padding-bottom: 10px; margin-bottom: 6px; border-bottom: 1px solid var(--rule);
  }
  .mega__col ul { display: grid; gap: 1px; margin: 0; padding: 0; }
  .mega__col a, .nav__list .mega__col a {
    display: block; padding: 8px 10px; margin: 0 -10px; border-radius: 6px;
    font-size: 14.5px; font-weight: 500; color: #111;
  }
  .mega a::after { display: none; }
  .nav__list .mega__col a:hover, .nav__list .mega__col a:focus-visible { background: var(--sand-2); color: var(--brand); }
  .nav__list .mega__all {
    grid-column: 1 / -1; justify-self: start; margin-top: 12px; padding-top: 14px; width: 100%;
    border-top: 1px solid var(--rule); font-size: 14.5px; font-weight: 700; color: var(--brand);
  }
  .nav__list .mega__all:hover { color: var(--brand-deep); }

  .header-actions { display: flex; align-items: center; gap: 20px; }
  .header-phone { display: inline-flex; align-items: center; justify-content: center; gap: 8px; min-width: 44px; min-height: 44px; font-size: 14px; font-weight: 600; text-decoration: none; color: var(--paper-dim); font-variant-numeric: tabular-nums; }
  .header-phone:hover { color: var(--paper); }

  .menu-toggle {
    display: none; position: relative; width: 44px; height: 44px; padding: 0;
    border: 1px solid var(--line); border-radius: 50%; background: rgba(0, 0, 0, 0.3); color: var(--paper); cursor: pointer;
  }
  .menu-toggle__bar { position: absolute; left: 13px; right: 13px; top: 50%; height: 1.5px; margin-top: -0.75px; background: currentColor; transition: transform 0.35s var(--ease-out); }
  .menu-toggle__bar:nth-of-type(2) { transform: translateY(-3.5px); }
  .menu-toggle__bar:nth-of-type(3) { transform: translateY(3.5px); }
  .menu-toggle[aria-expanded="true"] .menu-toggle__bar:nth-of-type(2) { transform: rotate(45deg); }
  .menu-toggle[aria-expanded="true"] .menu-toggle__bar:nth-of-type(3) { transform: rotate(-45deg); }

  @media (max-width: 1100px) {
    .header-phone span { display: none; }
    .nav__list { gap: 24px; }
  }

  @media (max-width: 1024px) {
    .header-phone { display: none; }
    .menu-toggle { display: block; }
    .nav__list {
      position: fixed; inset: 0 0 auto 0; z-index: -1;
      flex-direction: column; gap: 0;
      max-height: 100dvh; overflow-y: auto;
      padding: calc(var(--header-h) + 8px) var(--gutter) 28px;
      background: rgba(0, 0, 0, 0.96);
      -webkit-backdrop-filter: blur(16px); backdrop-filter: blur(16px);
      border-bottom: 1px solid var(--line-soft);
      transform: translateY(-100%); visibility: hidden;
      transition: transform 0.5s var(--ease-out), visibility 0.5s;
    }
    :global(.nav__list.is-open) { transform: none; visibility: visible; }
    .nav__list { height: auto; align-items: stretch; }
    .has-mega { height: auto; display: block; }
    .mega, .chev { display: none; }
    .nav__list li { border-bottom: 1px solid var(--line-soft); }
    .nav__list a { display: block; padding: 16px 0; font: 650 30px/1.1 var(--font-display); color: var(--paper); }
    .nav__list a::after { display: none; }
    .nav__list a[aria-current="page"] { color: var(--brand-tint); }
    .nav__mobile-only { display: block; }
    .nav__mobile-only a { font: 600 15px/1 var(--font-ui); color: var(--brand-tint); padding: 22px 0 18px; }
    .nav__mobile-only:last-child { border-bottom: 0; }
    .nav__mobile-only .nav__mobile-cta {
      display: flex; align-items: center; justify-content: center; height: 52px; padding: 0; margin-top: 8px;
      border-radius: 4px; background: var(--brand); color: #fff;
    }
  }

  @media (max-width: 1024px) {
    .site-header { --header-h: 76px; }
    :global(.site-header.is-scrolled) { --header-h: 68px; }
    .brand__logo { --logo-h: 62px; }
    :global(.site-header.is-scrolled) .brand__logo { --logo-h: 54px; }
  }

  @media (max-width: 560px) {
    .header-cta { display: none; }
    .brand__logo { --logo-h: 58px; }
    :global(.site-header.is-scrolled) .brand__logo { --logo-h: 52px; }
  }

  @media (max-height: 560px) and (orientation: landscape) {
    .site-header, :global(.site-header.is-scrolled) { --header-h: 64px; }
    .brand__logo, :global(.site-header.is-scrolled) .brand__logo { --logo-h: 54px; }
  }
</style>
