---
// "Why choose us": every point follows the client's published terms (/terms) or their own earlier site,
// worded so it does not promise more than those do (no fixed-price or guaranteed-finish-date claims).
const values = [
  { title: 'Experienced trades', text: 'Skilled tradespeople on every job, doing the work properly and in the right order.' },
  { title: 'Written quotes', text: 'Your price is set out in a written quotation, and any extra work is confirmed in writing first.' },
  { title: 'Fully insured', text: 'Public and employers’ liability insurance to £1,000,000 on every job.' },
  { title: 'Written guarantee', text: 'A 12-month guarantee on new workmanship, set out in our terms.' },
  { title: 'Protected home', text: 'Dust sheets and sheeting over floors and surfaces, and a tidy site while we work.' },
  { title: 'Agreed schedule', text: 'We agree the timescale with you before we start and keep you updated throughout.' },
];

interface Props {
  heading?: boolean;
}
const { heading = true } = Astro.props;
---
<section class="why section" aria-labelledby={heading ? 'why-title' : undefined} aria-label={heading ? undefined : 'Why choose us'}>
  <div class="container">
    {heading && (
      <div class="why__head">
        <p class="why__eyebrow" data-reveal>Why choose us</p>
        <h2 class="why__title" id="why-title" data-reveal>
          Dependable building,<br />
          <em>done properly.</em>
        </h2>
      </div>
    )}

    <div class="why__body">
      <figure class="why__media" data-reveal>
        <img src="/gallery/brickwork-2.webp" alt="" width="1280" height="853" loading="lazy" decoding="async" />
      </figure>

      <ol class="why__list" role="list">
        {values.map((v, i) => (
          <li class="why__item" data-reveal>
            <span class="why__num">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="why__name">{v.title}</h3>
            <p class="why__text">{v.text}</p>
          </li>
        ))}
      </ol>
    </div>
    <p class="why__note">Insurance and guarantee details are in our <a href="/terms">terms &amp; conditions</a>.</p>
  </div>
</section>

<style>
  .why { background: var(--sand-2); color: var(--char); }

  .why__head { margin-bottom: clamp(40px, 5vw, 72px); }
  .why__eyebrow { font-size: 12.5px; font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase; color: var(--brand-tint); margin-bottom: 18px; }
  .why__title { font: 700 clamp(38px, 5vw, 76px)/1 var(--font-display); letter-spacing: -0.035em; }
  .why__title em { font-style: italic; color: var(--brand-tint); }

  .why__body { display: grid; grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr); gap: clamp(32px, 5vw, 72px); align-items: stretch; }
  .why__media { margin: 0; min-height: 420px; overflow: hidden; background: var(--rule); }
  .why__media img { width: 100%; height: 100%; object-fit: cover; }

  .why__list { display: grid; grid-template-columns: 1fr 1fr; gap: 0 clamp(24px, 3vw, 44px); margin: 0; padding: 0; align-content: start; }
  .why__item { padding: 24px 0 30px; border-top: 1px solid var(--rule); }
  .why__num { display: block; font-size: 14px; font-style: italic; font-weight: 600; color: var(--brand-tint); margin-bottom: 14px; }
  .why__name { font: 700 18px/1.25 var(--font-display); letter-spacing: -0.015em; margin-bottom: 8px; }
  .why__text { font-size: 14.5px; line-height: 1.6; color: var(--char-dim); max-width: 34ch; }

  .why__note { margin-top: 28px; font-size: 13px; color: var(--char-faint); }
  .why__note a { color: var(--char-dim); }

  @media (max-width: 900px) {
    .why__body { grid-template-columns: 1fr; }
    .why__media { min-height: 0; aspect-ratio: 16 / 10; }
  }
  @media (max-width: 520px) {
    .why__list { grid-template-columns: 1fr; }
    .why__item { padding: 20px 0 22px; }
  }
</style>
