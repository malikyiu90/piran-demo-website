---
// The four commitments from the client's original site, rewritten for clarity.
const values = [
  { title: 'Experience', text: 'Experienced trades on every job, so the work is done properly and in the right order.' },
  { title: 'Quality', text: 'Good materials and close attention to detail, in the parts you see and the parts you don’t.' },
  { title: 'Communication', text: 'Clear updates and no surprises, from the first call to handover.' },
  { title: 'Fair pricing', text: 'Competitive, written quotations that are clear about what is included.' },
];

interface Props {
  heading?: boolean;
}
const { heading = true } = Astro.props;
---
<section class="values section on-light" aria-labelledby={heading ? 'values-title' : undefined} aria-label={heading ? undefined : 'Our commitments'}>
  <div class="container">
    {heading && (
      <div class="values__intro">
        <p class="eyebrow" data-reveal>About us</p>
        <h2 class="h2" id="values-title" data-reveal>A Coventry building team that looks after the whole job.</h2>
        <p class="lede" data-reveal>From the first call to the final coat of paint, you deal with one company and get a written quotation before any work starts.</p>
      </div>
    )}
    <ol class="values__grid" role="list">
      {values.map((v) => (
        <li class="value" data-reveal>
          <h3 class="value__title">{v.title}</h3>
          <p class="value__text">{v.text}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .values__intro { display: grid; grid-template-columns: 1fr minmax(260px, 380px); gap: 22px 64px; align-items: end; margin-bottom: clamp(48px, 6vw, 88px); }
  .values__intro .eyebrow { grid-column: 1 / -1; }
  .values__intro .h2 { max-width: 18ch; }
  .values__grid { display: grid; grid-template-columns: repeat(4, 1fr); border-top: 1px solid var(--rule); margin: 0; padding: 0; }
  .value { padding: 28px 28px 8px 0; border-right: 1px solid var(--rule); }
  .value + .value { padding-left: 28px; }
  .value:last-child { border-right: 0; }
  .value__title { font: 700 22px/1.2 var(--font-display); letter-spacing: -0.02em; margin-bottom: 10px; }
  .value__text { font-size: 15.5px; color: var(--char-dim); max-width: 30ch; }

  @media (max-width: 980px) {
    .values__intro { grid-template-columns: 1fr; }
    .values__grid { grid-template-columns: 1fr 1fr; }
    .value { padding: 28px 24px 28px 0; border-bottom: 1px solid var(--rule); }
    .value + .value { padding-left: 0; }
    .value:nth-child(even) { padding-left: 24px; border-right: 0; }
  }
  @media (max-width: 560px) {
    .values__grid { grid-template-columns: 1fr; }
    .value, .value:nth-child(even) { padding: 24px 0; border-right: 0; }
  }
</style>
