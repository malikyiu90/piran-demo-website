---
// Based on the client's own process: a call to discuss requirements, then a follow-up proposal and quotation.
const steps = [
  { title: 'Free consultation', text: 'We call you to talk through what you want, your timescale and your budget.' },
  { title: 'Proposal & quotation', text: 'We send a proposal of work and a written quotation. Any extra work is confirmed in writing, with its cost, first.' },
  { title: 'Build', text: 'Our team brings in the trades in the right order and keeps you up to date as the work progresses.' },
  { title: 'Handover', text: 'We walk through the finished work with you and make sure you are happy with it.' },
];

---
<section class="process section on-light" aria-labelledby="process-title">
  <div class="container">
    <div class="process__head">
      <p class="eyebrow" data-reveal>How we work</p>
      <h2 class="h2" id="process-title" data-reveal>How a project runs with us.</h2>
    </div>

    <ol class="process__steps" role="list">
      {steps.map((s) => (
        <li class="step" data-reveal>
          <h3 class="step__title">{s.title}</h3>
          <p class="step__text">{s.text}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .process__head { display: grid; gap: 20px; margin-bottom: clamp(48px, 6vw, 80px); }
  .process__steps { display: grid; grid-template-columns: repeat(4, 1fr); gap: 0; margin: 0; padding: 0; counter-reset: step; }
  .step { padding: 28px 28px 0 0; border-top: 2px solid var(--line); }
  .step + .step { padding-left: 28px; }
  .step:first-child { border-top-color: var(--brand); }
  .step__title { margin-top: 0; font: 700 22px/1.2 var(--font-display); letter-spacing: -0.02em; }
  .step__text { margin-top: 12px; color: var(--char-dim); font-size: 15.5px; max-width: 30ch; }

  @media (max-width: 900px) {
    .process__steps { grid-template-columns: 1fr 1fr; row-gap: 40px; }
    .step:nth-child(3) { padding-left: 0; }
  }
  @media (max-width: 560px) {
    .process__steps { grid-template-columns: 1fr; row-gap: 32px; }
    .step + .step { padding-left: 0; }
  }
</style>
