---
import { categories, servicesIn } from '../data/services';
import { site } from '../data/site';

interface Props {
  /** Pre-selects a service, e.g. on a service page. */
  service?: string;
}
const { service } = Astro.props;
---
<div class="quote-card" data-quote>
  <form class="quote-form" action="/api/quote" method="post" novalidate data-quote-form>
    <div class="quote-form__head">
      <p class="quote-form__title">Request a free quote</p>
      <p class="quote-form__sub">Takes about a minute. We’ll call you back to talk it through.</p>
    </div>
    <div class="quote-form__error" role="alert" data-form-error hidden></div>

    <div class="field-row">
      <div class="field">
        <label for="q-name">Full name</label>
        <input id="q-name" name="name" type="text" autocomplete="name" required minlength="2" maxlength="80" aria-describedby="q-name-err" />
        <p class="field__error" id="q-name-err" data-error-for="name"></p>
      </div>
      <div class="field">
        <label for="q-email">Email</label>
        <input id="q-email" name="email" type="email" autocomplete="email" required maxlength="254" aria-describedby="q-email-err" />
        <p class="field__error" id="q-email-err" data-error-for="email"></p>
      </div>
    </div>

    <div class="field-row">
      <div class="field">
        <label for="q-phone">Phone</label>
        <input id="q-phone" name="phone" type="tel" autocomplete="tel" required pattern="\+?[0-9][0-9 ()\-]{6,19}" aria-describedby="q-phone-err" />
        <p class="field__error" id="q-phone-err" data-error-for="phone"></p>
      </div>
      <div class="field">
        <label for="q-service">Service</label>
        <div class="select">
          <select id="q-service" name="service" required aria-describedby="q-service-err">
            <option value="" selected={!service}>Choose a service</option>
            {categories.map((c) => (
              <optgroup label={c.name}>
                {servicesIn(c.id).map((s) => <option value={s.slug} selected={s.slug === service}>{s.name}</option>)}
              </optgroup>
            ))}
            <option value="other">Something else</option>
          </select>
        </div>
        <p class="field__error" id="q-service-err" data-error-for="service"></p>
      </div>
    </div>

    <div class="field">
      <label for="q-message">About your project</label>
      <textarea id="q-message" name="message" rows="5" required minlength="10" maxlength="2000" aria-describedby="q-message-hint q-message-err" placeholder="What would you like to build or renovate? Any timescales?"></textarea>
      <p class="field__hint" id="q-message-hint"><span data-count>0</span>/2000</p>
      <p class="field__error" id="q-message-err" data-error-for="message"></p>
    </div>

    <div class="field field--check">
      <input id="q-consent" name="consent" type="checkbox" value="yes" required aria-describedby="q-consent-err" />
      <label for="q-consent">You can contact me about this enquiry. See our <a href="/privacy">privacy notice</a>.</label>
      <p class="field__error" id="q-consent-err" data-error-for="consent"></p>
    </div>

    <!-- Honeypot: hidden from people, tempting to bots. -->
    <div class="hp" aria-hidden="true">
      <label for="q-website">Website</label>
      <input id="q-website" name="website" type="text" tabindex="-1" autocomplete="off" />
    </div>
    <input type="hidden" name="submissionId" data-submission-id />
    <input type="hidden" name="startedAt" data-started-at />

    <div class="quote-form__foot">
      <button class="btn btn--primary quote-form__submit" type="submit" data-submit>
        <span data-submit-label>Send my request</span>
        <svg aria-hidden="true" viewBox="0 0 24 24" width="18" height="18"><path fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M13 6l6 6-6 6"/></svg>
      </button>
      <p class="quote-form__note">
        <svg aria-hidden="true" viewBox="0 0 24 24" width="16" height="16"><path fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" d="M12 3l7 3v5c0 4.6-3 8.4-7 10-4-1.6-7-5.4-7-10V6l7-3z"/></svg>
        Free consultation, no obligation. Your details are only used for this enquiry.
      </p>
    </div>
  </form>

  <div class="quote-success" data-success hidden tabindex="-1">
    <span class="quote-success__icon" aria-hidden="true">
      <svg viewBox="0 0 24 24" width="28" height="28"><path fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" d="M5 12.5l4.5 4.5L19 7.5"/></svg>
    </span>
    <h3 class="quote-success__title">Thank you, we’ve got it.</h3>
    <p>We’ll call you to discuss your requirements, then follow up with a proposal of work and a quotation.</p>
    <p class="quote-success__note">Need us sooner? Call <a href={site.phoneHref}>{site.phone}</a> or <a href={site.whatsappHref} target="_blank" rel="noopener">WhatsApp us</a>.</p>
  </div>
</div>

<script>
  const NO_JS_ERRORS: Record<string, string> = {
    invalid: 'Some details were missing or invalid. Please check the form and try again.',
    too_fast: 'That was quick! Please check your details and send again.',
    rate_limited: 'Too many requests. Please wait a few minutes, or call us instead.',
    send_failed: 'We couldn’t send your request just now. Please call or WhatsApp us instead.',
    not_configured: 'Online quotes are temporarily unavailable. Please call or WhatsApp us instead.',
    forbidden: 'Your request was blocked. Please call or WhatsApp us instead.',
    too_large: 'Your message was too long. Please shorten it and try again.',
  };

  const MESSAGES: Record<string, (el: HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement) => string> = {
    name: () => 'Please enter your name.',
    email: (el) => (el.value ? 'Please enter a valid email address.' : 'Please enter your email address.'),
    phone: (el) => (el.value ? 'Please enter a valid phone number.' : 'Please enter your phone number.'),
    service: () => 'Please choose a service.',
    message: (el) => (el.value.trim().length ? 'Please tell us a little more (at least 10 characters).' : 'Please tell us about your project.'),
    consent: () => 'Please confirm we can contact you about your enquiry.',
  };

  document.querySelectorAll<HTMLElement>('[data-quote]').forEach((root) => {
    const form = root.querySelector<HTMLFormElement>('[data-quote-form]')!;
    const success = root.querySelector<HTMLElement>('[data-success]')!;
    const formError = root.querySelector<HTMLElement>('[data-form-error]')!;
    const submit = root.querySelector<HTMLButtonElement>('[data-submit]')!;
    const submitLabel = root.querySelector<HTMLElement>('[data-submit-label]')!;
    const message = form.elements.namedItem('message') as HTMLTextAreaElement;
    const count = root.querySelector<HTMLElement>('[data-count]');
    const idField = root.querySelector<HTMLInputElement>('[data-submission-id]')!;
    const startedField = root.querySelector<HTMLInputElement>('[data-started-at]')!;

    const newId = () => (crypto.randomUUID ? crypto.randomUUID() : `${Date.now()}-${Math.random().toString(36).slice(2, 10)}`);
    idField.value = newId();
    startedField.value = String(Date.now());

    const params = new URLSearchParams(window.location.search);
    const preset = params.get('service');
    const select = form.elements.namedItem('service') as HTMLSelectElement;
    if (preset && [...select.options].some((o) => o.value === preset)) select.value = preset;
    const noJsError = params.get('error');
    if (noJsError) showFormError(NO_JS_ERRORS[noJsError] ?? NO_JS_ERRORS.invalid);

    message.addEventListener('input', () => { if (count) count.textContent = String(message.value.length); });

    const fields = () => [...form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement>('input:not([type=hidden]):not([name=website]), select, textarea')];

    function setError(name: string, text: string) {
      const el = form.elements.namedItem(name) as HTMLElement | null;
      const slot = root.querySelector<HTMLElement>(`[data-error-for="${name}"]`);
      if (slot) slot.textContent = text;
      el?.setAttribute('aria-invalid', text ? 'true' : 'false');
      el?.closest('.field')?.classList.toggle('is-invalid', Boolean(text));
    }

    function validateField(el: HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement) {
      const valid = el.name === 'message' ? el.value.trim().length >= 10 && el.checkValidity() : el.checkValidity();
      setError(el.name, valid ? '' : (MESSAGES[el.name]?.(el) ?? 'Please check this field.'));
      return valid;
    }

    function showFormError(text: string) {
      formError.textContent = text;
      formError.hidden = !text;
    }

    fields().forEach((el) => {
      el.addEventListener('blur', () => { if (el.value || el.closest('.is-invalid')) validateField(el); });
      el.addEventListener('input', () => { if (el.closest('.is-invalid')) validateField(el); });
      el.addEventListener('change', () => { if (el.closest('.is-invalid')) validateField(el); });
    });

    let sending = false;
    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (sending) return;
      showFormError('');

      const invalid = fields().filter((el) => !validateField(el));
      if (invalid.length) {
        invalid[0].focus();
        return;
      }

      sending = true;
      submit.disabled = true;
      submitLabel.textContent = 'Sending…';
      try {
        const response = await fetch(form.action, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify(Object.fromEntries(new FormData(form).entries())),
        });
        const body = await response.json().catch(() => ({ ok: false, message: NO_JS_ERRORS.send_failed }));
        if (response.ok && body.ok) {
          form.hidden = true;
          success.hidden = false;
          success.focus();
          return;
        }
        if (body.errors) {
          Object.entries(body.errors as Record<string, string>).forEach(([name, text]) => {
            if (name === 'form' || name === 'submissionId' || name === 'startedAt') showFormError(text);
            else setError(name, text);
          });
          const first = form.querySelector<HTMLElement>('[aria-invalid="true"]');
          first?.focus();
          if (!first) formError.focus();
        } else {
          showFormError(body.message ?? NO_JS_ERRORS.send_failed);
        }
        // A fresh id lets the user retry after a server-side failure.
        if (response.status >= 500) idField.value = newId();
      } catch {
        showFormError('No connection. Please check your internet and try again, or call us instead.');
      } finally {
        sending = false;
        submit.disabled = false;
        submitLabel.textContent = 'Send my request';
      }
    });
  });
</script>

<style>
  .quote-card {
    position: relative; padding: clamp(24px, 3.5vw, 44px);
    border-radius: 14px; background: var(--sand-2); color: var(--char); border: 1px solid var(--rule);
    box-shadow: 0 30px 80px -30px rgba(0, 0, 0, 0.55);
  }
  .quote-form { display: grid; gap: 20px; }
  .field-row { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
  .field { display: grid; gap: 8px; align-content: start; }
  .field label { font-size: 13px; font-weight: 600; letter-spacing: 0.02em; color: var(--char); }
  .field input:not([type="checkbox"]), .field select, .field textarea {
    width: 100%; min-height: 54px; padding: 14px 16px;
    border: 1px solid var(--rule); border-radius: 8px; background: #17191c;
    font-size: 16px; color: var(--char);
    transition: border-color 0.2s ease, box-shadow 0.2s ease, background-color 0.2s ease;
  }
  .field textarea { resize: vertical; min-height: 140px; line-height: 1.5; }
  .field input::placeholder, .field textarea::placeholder { color: var(--char-faint); }
  .field input:hover, .field select:hover, .field textarea:hover { border-color: rgba(255, 255, 255, 0.28); }
  .field input:focus, .field select:focus, .field textarea:focus { outline: none; border-color: var(--brand); background: #1b1e22; box-shadow: 0 0 0 4px rgba(217, 169, 46, 0.25); }
  .select { position: relative; }
  .select::after { content: ""; position: absolute; right: 18px; top: 50%; width: 8px; height: 8px; border-right: 1.5px solid var(--char-dim); border-bottom: 1.5px solid var(--char-dim); transform: translateY(-70%) rotate(45deg); pointer-events: none; }
  .field select option { background: #17191c; color: #fff; }
  .field select { appearance: none; padding-right: 44px; cursor: pointer; }

  .field__hint { font-size: 13px; color: var(--char-faint); text-align: right; margin-top: -2px; font-variant-numeric: tabular-nums; }
  .field__error { font-size: 13px; font-weight: 500; color: #ff8a80; min-height: 0; }
  .field__error:empty { display: none; }
  .is-invalid input:not([type="checkbox"]), .is-invalid select, .is-invalid textarea { border-color: #ff5252; background: rgba(255, 82, 82, 0.08); }

  .field--check { grid-template-columns: auto 1fr; column-gap: 12px; align-items: start; }
  .field--check input { width: 24px; height: 24px; margin: 1px 0 0; accent-color: var(--brand); cursor: pointer; }
  .field--check label { font-size: 14px; font-weight: 400; color: var(--char-dim); cursor: pointer; }
  .field--check label a { color: var(--brand-tint); }
  .field--check .field__error { grid-column: 2; }

  .hp { position: absolute; left: -10000px; width: 1px; height: 1px; overflow: hidden; }

  .quote-form__error { padding: 14px 16px; border-radius: 12px; background: rgba(255, 82, 82, 0.12); color: #ffb4ab; border: 1px solid rgba(255, 82, 82, 0.35); font-size: 14px; font-weight: 500; }
  .quote-form__head { padding-bottom: 20px; margin-bottom: 4px; border-bottom: 1px solid var(--rule); }
  .quote-form__title { font: 700 24px/1.2 var(--font-display); letter-spacing: -0.02em; }
  .quote-form__sub { margin-top: 6px; font-size: 14.5px; color: var(--char-dim); }
  .quote-form__foot { display: grid; gap: 14px; margin-top: 4px; }
  .quote-form__submit { width: 100%; --h: 56px; font-size: 16px; }
  .quote-form__note { display: flex; align-items: flex-start; gap: 8px; font-size: 13.5px; color: var(--char-dim); }
  .quote-form__note svg { flex: none; margin-top: 1px; color: var(--brand-tint); }
  .quote-form__submit[disabled] { cursor: progress; }

  .quote-success { display: grid; gap: 14px; justify-items: start; padding: 12px 0; outline: none; }
  .quote-success[hidden] { display: none; }
  .quote-success__icon { display: grid; place-items: center; width: 56px; height: 56px; border-radius: 50%; background: rgba(217, 169, 46, 0.18); color: var(--brand-tint); }
  .quote-success__title { font: 650 clamp(32px, 3.4vw, 44px)/1.05 var(--font-display); }
  .quote-success p { color: var(--char-dim); max-width: 46ch; }
  .quote-success a { color: var(--brand-tint); font-weight: 600; }

  @media (max-width: 640px) {
    .field-row { grid-template-columns: 1fr; }
  }
</style>
