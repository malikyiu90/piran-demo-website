---
interface Props {
  items: { q: string; a: string }[];
}
const { items } = Astro.props;
---
<div class="faq">
  {items.map((item) => (
    <details class="faq__item" data-reveal>
      <summary>
        <span>{item.q}</span>
        <span class="faq__icon" aria-hidden="true"></span>
      </summary>
      <p>{item.a}</p>
    </details>
  ))}
</div>

<style>
  .faq { border-top: 1px solid var(--rule); }
  .faq__item { border-bottom: 1px solid var(--rule); }
  .faq__item summary {
    display: flex; align-items: center; justify-content: space-between; gap: 24px;
    padding: 24px 0; cursor: pointer; list-style: none;
    font: 650 clamp(22px, 2vw, 28px)/1.2 var(--font-display);
  }
  .faq__item summary::-webkit-details-marker { display: none; }
  .faq__icon { position: relative; flex: none; width: 36px; height: 36px; border: 1px solid var(--rule); border-radius: 50%; transition: background-color 0.3s ease, transform 0.4s var(--ease-out); }
  .faq__icon::before, .faq__icon::after { content: ""; position: absolute; left: 50%; top: 50%; width: 12px; height: 1.5px; margin: -0.75px 0 0 -6px; background: currentColor; transition: transform 0.4s var(--ease-out); }
  .faq__icon::after { transform: rotate(90deg); }
  .faq__item[open] .faq__icon { background: var(--brand); color: #fff; border-color: var(--brand); }
  .faq__item[open] .faq__icon::after { transform: rotate(0deg); }
  .faq__item summary:hover .faq__icon { border-color: var(--brand-tint); }
  .faq__item p { padding: 0 56px 26px 0; color: var(--char-dim); font-size: 16px; line-height: 1.65; max-width: 64ch; }
</style>
