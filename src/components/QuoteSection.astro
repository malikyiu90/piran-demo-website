---
import QuoteForm from './QuoteForm.astro';
import { site } from '../data/site';

interface Props {
  service?: string;
}
const { service } = Astro.props;

const contacts = [
  { label: 'Call us', value: site.phone, href: site.phoneHref, icon: 'M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25 11.4 11.4 0 0 0 3.6.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.57a1 1 0 0 1-.25 1z', fill: true },
  { label: 'WhatsApp', value: 'Message us', href: site.whatsappHref, icon: 'M3.5 20.5l1.3-4.2A8.5 8.5 0 1 1 8 19.4l-4.5 1.1zM9 8.5c.2 2.6 2.7 5.4 5.7 6.2l1.3-1.4-1.8-1-1 .8c-1-.4-2-1.4-2.4-2.4l.8-1-1-1.8L9 8.5z', fill: false },
  { label: 'Email', value: site.email, href: `mailto:${site.email}`, icon: 'M3 6h18v12H3V6zm0 0l9 7 9-7', fill: false },
];
const nextSteps = [
  'We call you to talk through your project.',
  'You get a proposal of work and a written quotation.',
  'Once you’re happy, we agree a start date.',
];
---
<section class="quote section on-ink" id="quote" aria-labelledby="quote-title">
  <div class="container quote__grid">
    <div class="quote__intro">
      <p class="eyebrow" data-reveal>Free consultation</p>
      <h2 class="h2" id="quote-title" data-reveal>Tell us about your project.</h2>
      <p class="lede" data-reveal>Share a few details and we’ll call you to discuss your requirements, then follow up with a proposal of work and a written quotation.</p>

      <ul class="quote__contacts" role="list" data-reveal>
        {contacts.map((c) => (
          <li>
            <a class="contact" href={c.href} target={c.href.startsWith('http') ? '_blank' : undefined} rel={c.href.startsWith('http') ? 'noopener' : undefined}>
              <span class="contact__icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="20" height="20"><path d={c.icon} fill={c.fill ? 'currentColor' : 'none'} stroke={c.fill ? 'none' : 'currentColor'} stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" /></svg>
              </span>
              <span class="contact__text">
                <span class="contact__label">{c.label}</span>
                <span class="contact__value">{c.value}</span>
              </span>
              <span class="contact__arrow" aria-hidden="true">→</span>
            </a>
          </li>
        ))}
      </ul>

      <div class="quote__next" data-reveal>
        <p class="quote__next-title">What happens next</p>
        <ol role="list">
          {nextSteps.map((step, i) => <li><span>{i + 1}</span>{step}</li>)}
        </ol>
      </div>
    </div>

    <div data-reveal>
      <QuoteForm service={service} />
    </div>
  </div>
</section>

<style>
  .quote__grid { display: grid; grid-template-columns: 0.9fr 1.1fr; gap: clamp(40px, 6vw, 96px); align-items: start; }
  .quote__intro { display: grid; gap: 22px; position: sticky; top: 120px; }

  .quote__contacts { display: grid; gap: 10px; margin: 10px 0 0; padding: 0; }
  .contact {
    display: grid; grid-template-columns: 44px 1fr auto; align-items: center; gap: 14px;
    padding: 12px 16px 12px 12px; border: 1px solid var(--line-soft); border-radius: 10px;
    background: rgba(255, 255, 255, 0.04); text-decoration: none; color: #fff;
    transition: border-color 0.25s ease, background-color 0.25s ease;
  }
  .contact:hover { border-color: var(--brand); background: rgba(217, 169, 46, 0.12); }
  .contact__icon { display: grid; place-items: center; width: 44px; height: 44px; border-radius: 50%; background: var(--gold-fill); color: var(--on-brand); }
  .contact__text { display: grid; gap: 2px; min-width: 0; }
  .contact__label { font-size: 12.5px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--paper-faint); }
  .contact__value { font-size: 16px; font-weight: 600; overflow-wrap: anywhere; }
  .contact__arrow { color: var(--paper-faint); transition: transform 0.3s var(--ease-out), color 0.25s ease; }
  .contact:hover .contact__arrow { transform: translateX(4px); color: #fff; }

  .quote__next { margin-top: 8px; padding-top: 22px; border-top: 1px solid var(--line-soft); }
  .quote__next-title { font-size: 12.5px; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: var(--paper-dim); margin-bottom: 14px; }
  .quote__next ol { display: grid; gap: 12px; margin: 0; padding: 0; }
  .quote__next li { display: grid; grid-template-columns: 28px 1fr; gap: 12px; align-items: start; font-size: 15px; color: var(--paper-dim); }
  .quote__next li span {
    display: grid; place-items: center; width: 28px; height: 28px; border-radius: 50%;
    border: 1px solid var(--brand-tint); color: var(--brand-tint); font-size: 13px; font-weight: 700;
  }

  @media (max-width: 960px) {
    .quote__grid { grid-template-columns: 1fr; }
    .quote__intro { position: static; }
  }
</style>
