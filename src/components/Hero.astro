---
import { site } from '../data/site';
---
<section class="hero" data-hero data-frame-count="95" aria-labelledby="hero-title">
  <div class="hero__stage">
    <div class="hero__media" data-media>
      <canvas class="hero__canvas" data-canvas aria-hidden="true"></canvas>
    </div>
    <div class="hero__shade" aria-hidden="true"></div>

    <div class="chapter chapter--intro" data-chapter="0">
      <p class="eyebrow">Construction &amp; renovation · {site.locality}</p>
      <h1 class="display" id="hero-title">
        <span class="line"><span class="line__inner">From bare ground</span></span>
        <span class="line"><span class="line__inner">to home.</span></span>
      </h1>
      <p class="lede">Extensions, loft conversions, kitchens and full builds, planned, built and finished by one team.</p>
      <div class="cta-row">
        <a class="btn btn--primary" href="/contact#quote">
          Get a free quote
          <svg aria-hidden="true" viewBox="0 0 24 24" width="18" height="18"><path fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M13 6l6 6-6 6"/></svg>
        </a>
        <a class="btn btn--ghost" href="/services">Our services</a>
      </div>
    </div>

    <div class="chapter chapter--side" data-chapter="1">
      <p class="kicker">Structure</p>
      <h2 class="display display--md">Foundations and frame.</h2>
      <p class="lede lede--sm">Every joist measured, every load accounted for, before a single wall goes up.</p>
    </div>

    <div class="chapter chapter--side" data-chapter="2">
      <p class="kicker">Build &amp; finish</p>
      <h2 class="display display--md">Walls, roof and windows.</h2>
      <p class="lede lede--sm">Brick, render, glazing and stone, laid by trades who take pride in the detail.</p>
    </div>

    <div class="chapter chapter--final" data-chapter="3">
      <p class="kicker">Handover</p>
      <h2 class="display">Finished and handed over.</h2>
      <p class="lede">Tell us what you have in mind. We’ll call you, talk through the details and follow up with a clear proposal and quotation.</p>
      <div class="cta-row">
        <a class="btn btn--primary" href="/contact#quote">
          Book a free consultation
          <svg aria-hidden="true" viewBox="0 0 24 24" width="18" height="18"><path fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M13 6l6 6-6 6"/></svg>
        </a>
        <a class="btn btn--ghost" href={site.whatsappHref} target="_blank" rel="noopener">WhatsApp us</a>
      </div>
    </div>
  </div>
</section>

<script>
  import '../scripts/hero';
</script>

<style>
  .hero { position: relative; height: 100vh; height: 100svh; background: var(--ink); }
  .hero__stage { position: relative; height: 100%; overflow: hidden; isolation: isolate; }

  .hero__media {
    position: absolute; inset: 0; z-index: -2;
    background: var(--ink) url("/frames/poster.jpg") center / cover no-repeat;
    transform-origin: 50% 60%; will-change: transform;
  }
  .hero__canvas { width: 100%; height: 100%; opacity: 0; transition: opacity 0.6s ease; }
  :global(.hero__canvas.is-ready) { opacity: 1; }

  .hero__shade {
    position: absolute; inset: 0; z-index: -1; pointer-events: none;
    background:
      linear-gradient(180deg, rgba(0, 0, 0, 0.6) 0%, rgba(0, 0, 0, 0) 22%),
      linear-gradient(90deg, rgba(0, 0, 0, 0.62) 0%, rgba(0, 0, 0, 0.28) 32%, rgba(0, 0, 0, 0) 58%),
      linear-gradient(0deg, rgba(0, 0, 0, 0.75) 0%, rgba(0, 0, 0, 0) 40%);
  }

  .chapter { position: absolute; left: var(--gutter); width: min(620px, calc(100% - 2 * var(--gutter))); }
  /* Keeps the headline clear of the house in the centre of the frame. */
  .chapter--intro { bottom: clamp(56px, 11vh, 120px); width: min(880px, calc(100% - 2 * var(--gutter) - 200px)); }
  /* The two build-stage captions are centred low in the frame, under the house. Centring uses insets and
     auto margins rather than a transform, because GSAP animates y on the chapters. */
  .chapter--side {
    left: 0; right: 0; margin-inline: auto; bottom: clamp(48px, 9vh, 100px);
    width: min(640px, calc(100% - 2 * var(--gutter))); text-align: center;
  }
  .chapter--side .lede { margin-inline: auto; }
  .chapter--side .kicker { justify-content: center; }
  .chapter--final { bottom: clamp(56px, 11vh, 120px); width: min(560px, calc(100% - 2 * var(--gutter))); }

  .chapter:not([data-chapter="0"]) { display: none; }
  :global(.js) .chapter:not([data-chapter="0"]) { display: block; opacity: 0; visibility: hidden; }

  .eyebrow, .kicker { text-shadow: 0 1px 14px rgba(0, 0, 0, 0.55); }
  .eyebrow { margin-bottom: 22px; }

  .kicker {
    display: flex; align-items: center; gap: 14px; margin: 0 0 18px;
    font-size: 13px; font-weight: 600; letter-spacing: 0.16em; text-transform: uppercase; color: var(--brand-tint);
  }

  .display { text-shadow: 0 2px 40px rgba(0, 0, 0, 0.25); }
  .display--md { font-size: clamp(38px, min(4.4vw, 9vh), 72px); }

  .line { display: block; overflow: hidden; padding-bottom: 0.08em; margin-bottom: -0.08em; }
  .line__inner { display: block; }

  .lede { margin-top: 24px; max-width: 36ch; font-size: clamp(16px, 1.25vw, 19px); }
  .lede--sm { font-size: clamp(15px, 1.1vw, 17px); max-width: 40ch; }
  .cta-row { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 34px; }

  @media (max-width: 900px) {
    /* Tall phones: the text follows straight on from the image instead of sitting at the bottom of the screen. */
    :global(.hero[data-stack="true"]) .chapter { top: calc(var(--band-bottom, 50vh) + 18px); bottom: auto; transform: none; }
    .chapter--intro, .chapter--final { bottom: 64px; }
    .chapter--side { top: auto; bottom: 64px; transform: none; left: 0; right: 0; }
    .chapter--intro, .chapter--side, .chapter--final { width: min(640px, calc(100% - 2 * var(--gutter))); }
    .hero__shade {
      background:
        linear-gradient(180deg, rgba(0, 0, 0, 0.55) 0%, rgba(0, 0, 0, 0) 18%),
        linear-gradient(0deg, rgba(0, 0, 0, 0.85) 0%, rgba(0, 0, 0, 0.4) 42%, rgba(0, 0, 0, 0) 62%);
    }
  }

  /* Phones in landscape and other very short viewports. */
  @media (max-height: 560px) and (orientation: landscape) {
    .chapter--intro, .chapter--side, .chapter--final {
      top: auto; bottom: 46px; transform: none; width: min(640px, calc(100% - 2 * var(--gutter)));
    }
    .eyebrow, .kicker { margin-bottom: 10px; font-size: 12.5px; }
    .display { font-size: clamp(34px, 11vh, 56px); }
    .display--md { font-size: clamp(30px, 10vh, 48px); }
    .lede, .lede--sm { margin-top: 10px; font-size: 14px; line-height: 1.45; max-width: 56ch; }
    .cta-row { margin-top: 16px; }
    .cta-row .btn { --h: 44px; flex: 0 0 auto; padding: 0 20px; font-size: 14px; }
  }

  @media (max-width: 560px) {
    .display { font-size: clamp(46px, 13vw, 64px); }
    .display--md { font-size: clamp(40px, 11vw, 54px); }
    .hero__shade {
      background:
        linear-gradient(180deg, rgba(0, 0, 0, 0.55) 0%, rgba(0, 0, 0, 0) 16%),
        linear-gradient(0deg, rgba(0, 0, 0, 0.88) 0%, rgba(0, 0, 0, 0.5) 50%, rgba(0, 0, 0, 0) 78%);
    }
    .lede { margin-top: 18px; }
    .cta-row { margin-top: 26px; }
    .cta-row .btn { flex: 1 1 auto; }
  }
/* Small phones (e.g. 360×640): tighter type so the text block does not climb over the image. */
  @media (max-width: 560px) and (max-height: 720px) {
    .display { font-size: clamp(36px, 10.5vw, 46px); }
    .display--md { font-size: clamp(32px, 9.5vw, 42px); }
    .eyebrow { font-size: 11.5px; letter-spacing: 0.1em; margin-bottom: 14px; }
    .lede, .lede--sm { margin-top: 12px; font-size: 15px; line-height: 1.5; }
    .cta-row { margin-top: 18px; flex-wrap: wrap; }
    .cta-row .btn { --h: 48px; padding: 0 14px; font-size: 14.5px; }
  }
</style>
