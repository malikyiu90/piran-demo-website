---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Values from '../components/Values.astro';
import Stats from '../components/Stats.astro';
import ServiceList from '../components/ServiceList.astro';
import Process from '../components/Process.astro';
import Gallery from '../components/Gallery.astro';
import LandlordsBand from '../components/LandlordsBand.astro';
import Reviews from '../components/Reviews.astro';
import FaqSection from '../components/FaqSection.astro';
import QuoteSection from '../components/QuoteSection.astro';
import { site } from '../data/site';

---
<Base
  title={site.name}
  description="Extensions, loft conversions, kitchens, bathrooms and full builds across Coventry. Book a free consultation."
  preload="/frames/poster.jpg"
  hideFooterCta
>
  <!-- Order follows the visitor's questions: what do you do, why you, show me, how does it work,
       who vouches for you, what about…, then contact. Landlords are a secondary audience, so last. -->
  <Hero />
  <Stats />
  <ServiceList />
  <Values />
  <Gallery />
  <Process />
  <Reviews />
  <FaqSection />
  <QuoteSection />
  <LandlordsBand />
</Base>
