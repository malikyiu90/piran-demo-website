---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Faq from '../../components/Faq.astro';
import QuoteSection from '../../components/QuoteSection.astro';
import Process from '../../components/Process.astro';
import Reviews from '../../components/Reviews.astro';
import { detailsFor } from '../../data/serviceDetails';
import { categoryOf, faqsFor, guaranteeFor, photoFor, photosFor, services, servicesIn, thumbOf, type Service } from '../../data/services';
import { site } from '../../data/site';

export function getStaticPaths() {
  return services.map((service) => ({ params: { slug: service.slug }, props: { service } }));
}

interface Props {
  service: Service;
}
const { service } = Astro.props;
const category = categoryOf(service);
const related = servicesIn(service.category).filter((s) => s.slug !== service.slug);
const guarantee = guaranteeFor(service);
const heroImage = photoFor(service).hero ?? category.image;
const photos = photosFor(service);
const details = detailsFor(service.slug);
const faqs = faqsFor(service);
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
---
<Base title={`${service.name} in ${site.locality}`} description={service.summary} image={heroImage} hideFooterCta>
  <PageHero
    eyebrow={category.name}
    title={`${service.name} in ${site.locality}`}
    lede={service.summary}
    image={heroImage}
    crumbs={[{ label: 'Services', href: '/services' }, { label: service.name }]}
  >
    <div class="hero-actions">
      <a class="btn btn--primary" href={`/contact?service=${service.slug}#quote`}>
        Get a quote
        <svg aria-hidden="true" viewBox="0 0 24 24" width="18" height="18"><path fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M13 6l6 6-6 6"/></svg>
      </a>
      <a class="btn btn--ghost" href={site.phoneHref}>{site.phone}</a>
    </div>
  </PageHero>

  <section class="detail section on-light">
    <div class="container detail__grid">
      <div class="detail__main">
        <div class="prose detail__intro" data-reveal>
          {service.intro.map((p) => <p>{p}</p>)}
        </div>

        <h2 class="h3 detail__heading" data-reveal>What’s included</h2>
        <ul class="includes" role="list">
          {service.includes.map((item) => (
            <li data-reveal>
              <svg aria-hidden="true" viewBox="0 0 24 24" width="18" height="18"><path fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" d="M5 12.5l4.5 4.5L19 7.5"/></svg>
              {item}
            </li>
          ))}
        </ul>

        {details && (
          <>
            <h2 class="h3 detail__heading" data-reveal>Options</h2>
            <ul class="options" role="list">
              {details.options.map((o) => (
                <li class="option" data-reveal>
                  <h3 class="option__name">{o.name}</h3>
                  <p class="option__text">{o.text}</p>
                </li>
              ))}
            </ul>

            <div class="planning" data-reveal>
              <p class="planning__label">Planning permission &amp; Building Regulations</p>
              <p>{details.planning}</p>
              <p class="planning__small">General guidance only; your local council has the final say. Under our <a href="/terms">terms</a>, arranging permissions is the customer’s responsibility, and we’re happy to talk it through on the first call.</p>
            </div>
          </>
        )}
      </div>

      <aside class="aside" aria-label={`More in ${category.name}`}>
        <div class="aside__card" data-reveal>
          <p class="aside__label">Every job includes</p>
          <ul role="list" class="aside__facts">
            <li>A written quotation</li>
            <li>Extras confirmed in writing first</li>
            {guarantee && <li>{guarantee}*</li>}
            <li>£1m public &amp; employers’ liability</li>
          </ul>
          <p class="aside__small">{guarantee ? '*On new work and materials. ' : ''}See our <a href="/terms">terms</a> for details.</p>
          <a class="btn btn--dark aside__cta" href={`/contact?service=${service.slug}#quote`}>Request a quote</a>
        </div>
        {related.length > 0 && (
          <div class="aside__related" data-reveal>
            <p class="aside__label">Also in {category.name}</p>
            <ul role="list">
              {related.map((r) => <li><a href={`/services/${r.slug}`}>{r.name}<span aria-hidden="true">→</span></a></li>)}
            </ul>
          </div>
        )}
      </aside>
    </div>
  </section>

  {photos.length > 0 && (
    <section class="photos section on-light" aria-labelledby="photos-title">
      <div class="container">
        <h2 class="h3 photos__title" id="photos-title" data-reveal>Example photos</h2>
        <ul class="photos__grid" role="list">
          {photos.map((photo, i) => (
            <li data-reveal>
              <img src={thumbOf(photo.src)} alt={`${service.name} example ${i + 1}`} width="720" height="480" loading="lazy" decoding="async" />
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <Process />
  <Reviews />

  <section class="service-faq section on-light" aria-labelledby="service-faq-title">
    <div class="container service-faq__grid">
      <h2 class="h2" id="service-faq-title" data-reveal>{service.name}: common questions.</h2>
      <Faq items={faqs} />
    </div>
  </section>

  <QuoteSection service={service.slug} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
</Base>

<style>
  .photos__title { margin-bottom: 24px; }
  .photos__grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; margin: 0; padding: 0; }
  .photos__grid li { aspect-ratio: 4 / 3; overflow: hidden; background: var(--sand-2); }
  .photos__grid img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.8s var(--ease-out); }
  .photos__grid li:hover img { transform: scale(1.05); }
  @media (max-width: 900px) { .photos__grid { grid-template-columns: 1fr 1fr; gap: 8px; } }

  .hero-actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 12px; }

  .detail__grid { display: grid; grid-template-columns: minmax(0, 1fr) 360px; gap: clamp(40px, 7vw, 120px); align-items: start; }
  .detail__intro { font-size: clamp(18px, 1.5vw, 21px); color: var(--char); }
  .detail__heading { margin: clamp(56px, 7vw, 88px) 0 28px; }

  .includes { display: grid; grid-template-columns: 1fr 1fr; gap: 0 32px; margin: 0; padding: 0; border-top: 1px solid var(--rule); }
  .includes li { display: flex; gap: 14px; align-items: flex-start; padding: 18px 0; border-bottom: 1px solid var(--rule); font-size: 16px; }
  .includes svg { flex: none; margin-top: 3px; color: var(--brand); }

  .aside { position: sticky; top: 100px; display: grid; gap: 20px; }
  .aside__card { padding: 30px; border-radius: 22px; background: #fff; box-shadow: 0 30px 80px -40px rgba(0, 0, 0, 0.3); }
  .aside__label { font-size: 13px; font-weight: 600; letter-spacing: 0.16em; text-transform: uppercase; color: var(--char-faint); margin-bottom: 16px; }
  .aside__facts { display: grid; gap: 12px; margin: 0; padding: 0; }
  .aside__facts li { position: relative; padding-left: 20px; font-size: 15px; }
  .aside__facts li::before { content: ""; position: absolute; left: 0; top: 0.6em; width: 7px; height: 7px; border-radius: 50%; background: var(--brand); }
  .aside__small { margin-top: 16px; font-size: 12.5px; color: var(--char-faint); }
  .aside__small a { color: var(--char-dim); }
  .aside__cta { width: 100%; margin-top: 22px; }
  .aside__related { padding: 4px 6px; }
  .aside__related ul { margin: 0; padding: 0; border-top: 1px solid var(--rule); }
  .aside__related a { display: flex; justify-content: space-between; padding: 14px 0; border-bottom: 1px solid var(--rule); text-decoration: none; font: 650 22px/1.2 var(--font-display); transition: color 0.2s ease, padding 0.3s var(--ease-out); }
  .aside__related a:hover { color: var(--brand); padding-left: 6px; }

  @media (max-width: 980px) {
    .detail__grid { grid-template-columns: 1fr; }
    .aside { position: static; }
  }
  .options { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; margin: 0; padding: 0; }
  .option { padding: 20px; background: var(--sand-2); border-top: 2px solid var(--brand); }
  .option__name { font: 700 17px/1.25 var(--font-display); letter-spacing: -0.015em; margin-bottom: 6px; }
  .option__text { font-size: 14.5px; line-height: 1.55; color: var(--char-dim); }

  .planning { margin-top: clamp(40px, 5vw, 64px); padding: 24px 26px; border: 1px solid var(--rule); border-left: 3px solid var(--brand); background: #fff; }
  .planning p { font-size: 15.5px; line-height: 1.65; color: var(--char-dim); }
  .planning p + p { margin-top: 10px; }
  .planning__label { font-size: 12.5px !important; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: var(--char) !important; margin-bottom: 10px; }
  .planning .planning__small { font-size: 13px; color: var(--char-faint); }
  .planning a { color: var(--char-dim); }

  .service-faq__grid { display: grid; grid-template-columns: 0.8fr 1.2fr; gap: clamp(32px, 5vw, 80px); align-items: start; }

  @media (max-width: 900px) {
    .options { grid-template-columns: 1fr; }
    .service-faq__grid { grid-template-columns: 1fr; }
  }

  @media (max-width: 600px) {
    .includes { grid-template-columns: 1fr; }
  }
</style>
