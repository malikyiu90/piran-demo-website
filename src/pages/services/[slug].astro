---
import ServicePage from '../../components/ServicePage.astro';
import { services, type Service } from '../../data/services';

// Services with their own address (Service.path, e.g. /hmo-renovations-coventry) are built by their own page file.
export function getStaticPaths() {
  return services.filter((s) => !s.path).map((service) => ({ params: { slug: service.slug }, props: { service } }));
}

interface Props {
  service: Service;
}
---
<ServicePage service={Astro.props.service} />
