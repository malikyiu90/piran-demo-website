# Quote form email delivery (https://resend.com). All three are required in production.
# Without them, `npm run dev` logs submissions to the console instead of sending them,
# and a production server answers form submissions with a "not configured" error.
RESEND_API_KEY=
# Inbox that receives quote requests, e.g. info@pirantrading.com
QUOTE_TO_EMAIL=
# Verified sender on your Resend domain, e.g. "Piran Website <website@pirantrading.com>"
QUOTE_FROM_EMAIL=
